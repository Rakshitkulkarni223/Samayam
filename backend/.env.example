# Server port (Render sets PORT automatically, so this is mainly for local dev)
PORT=5000

# MongoDB connection string.
# Local dev:  mongodb://127.0.0.1:27017/samayam_hospital
# Production: use a MongoDB Atlas free-tier URI, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/samayam_hospital?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/samayam_hospital

# Optional: override default admin credentials
SAMAYAM_ADMIN_USER=admin
SAMAYAM_ADMIN_PASS=admin123
