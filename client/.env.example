# Frontend API base URL.
# For local development, point to your local backend:
REACT_APP_API_BASE_URL=http://localhost:5000/api

# For production on Render, set this in the Static Site environment variables
# to your backend Web Service URL, e.g.:
#   REACT_APP_API_BASE_URL=https://samayam-backend.onrender.com/api
# (Leave it unset to fall back to "/api", useful only if served by the backend.)
