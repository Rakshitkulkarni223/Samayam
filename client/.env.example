# Backend port (Render will override this with its own PORT env var)
PORT=5000

# Frontend API base URL
# For local development, point to the backend URL below.
# For production (Render), change to: 
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: override default admin credentials
SAMAYAM_ADMIN_USER=admin
SAMAYAM_ADMIN_PASS=admin123
